 * Copyright (c) 2026 Dante Sangiorgio
 *
 * SPDX-License-Identifier: Apache-2.0
 *
 * Console and shell live on the Pico 2 native USB port (CDC-ACM).
 * Application logs are routed to UART0 (GP0 = TX, GP1 = RX), which is where
 * the external USB-UART converter is connected.
 *
 * Serial role map:
 *   console -> cdc_acm_uart0 (USB)  zephyr,console
 *   shell   -> cdc_acm_uart0 (USB)  zephyr,shell-uart
 *   logs    -> uart0 (GP0/GP1)      zephyr,log-uart
 * Recipes for moving any of these: see DEBUG_CONFIG.md.
 */

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,log-uart = &log_uarts;
	};

	log_uarts: log_uarts {
		compatible = "zephyr,log-uart";
		uarts = <&uart0>;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};
